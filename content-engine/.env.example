# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
SECRET_KEY=MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQDJDxZJVF/IT5pl\nPDW1iMYxUfg51n1hxakrqkSGyBvfyvVu8S6kCtZpy5FYATIrcS15LKiKPDwMpMMA\nDq//FyW7cvwkVQwbbhwET3gFQr6qW9eY9GV863xNf31r0/zwzCIjlphPtTPKM5Ow\nCw9CRGaXO/2ZYD2Pce9hZadPVhSVAbyG56FSMTCPeF6VNtjhYVaF7M+DyBrVWeMD\
DEBUG=true
