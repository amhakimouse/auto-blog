{
  "scripts": {
    "docker:up": "docker compose -f content-engine/docker-compose.yml up -d",
    "docker:down": "docker compose -f content-engine/docker-compose.yml down",
    "docker:logs": "docker compose -f content-engine/docker-compose.yml logs -f",
    "docker:build": "docker compose -f content-engine/docker-compose.yml build",
    "docker:rebuild": "docker compose -f content-engine/docker-compose.yml up -d --build"
  },
  "dependencies": {
    "opencode-ai": "^1.4.3"
  }
}
